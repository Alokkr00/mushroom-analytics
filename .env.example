# Environment variables for MycoMetrics ELT & Analytics
# Copy this file to .env and adjust credentials as appropriate.

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mycometrics
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA_RAW=raw
DB_SCHEMA_ANALYTICS=analytics
DB_SCHEMA_AUDIT=audit

# Pipeline & Data Generation
DATA_SEED=42
DATA_SCALE=small
PROJECT_ENV=development
DATA_DIR=data/generated
SAMPLE_DIR=data/raw_samples

# Timezone & Logging
APP_TIMEZONE=UTC
LOG_LEVEL=INFO
